# Local Supabase stack (started from cityBotIngestionLayer via `supabase start`).
# These are Supabase's well-known local-dev demo values — identical on every
# machine that runs the CLI, not secrets — safe to commit.
#
# The presentation layer only ever needs the URL + anon key (RLS-enforced,
# safe for the browser) — never the service_role key, which belongs only to
# server-side ingestion/admin code in cityBotIngestionLayer.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Existing mock/live switch (see lib/api/client.ts, .env.local) — flip to
# false once lib/api/* is wired to supabase-js against the URL/key above.
USE_MOCKS=true
